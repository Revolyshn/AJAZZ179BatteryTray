<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Default build carries its own runtime (~50 MB). Pass -p:SelfContained=false for a ~1 MB
         EXE that needs the .NET 10 Desktop Runtime (x64) installed. -->
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The SDK supports single-file compression only for self-contained apps. -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <!-- The UI is Russian; skip framework satellite resources for the other 12 languages. -->
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.4.0</Version>
    <Product>AJ179 Battery Tray</Product>
    <AssemblyTitle>AJ179 Battery Tray</AssemblyTitle>
    <Description>Заряд AJAZZ AJ179 PRO в области уведомлений Windows (неофициальная утилита)</Description>
    <Company>AJ179BatteryTray</Company>
    <Copyright>Неофициальная утилита. JetBrains Mono: SIL OFL 1.1</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\ajazz-silver.png" />
    <EmbeddedResource Include="Assets\JetBrainsMono-*.ttf" />
    <EmbeddedResource Include="Assets\JetBrainsMono-OFL.txt" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <InternalsVisibleTo Include="AJ179BatteryTray.Tests" />
  </ItemGroup>

</Project>
